commit f85c46ba8b913aa3208af0f3573db90286e56e18
Author: Dan Davison <dandavison7@gmail.com>
Date:   Sat Mar 28 16:15:30 2026 -0400

    CD: handle missing libc6 dependency in cross-compiled .debs
    
    The arm64/armhf .debs have empty Depends fields since
    dpkg-shlibdeps doesn't resolve cross-compiled libraries.
    Skip the libc version check for those instead of failing.
---
 .github/workflows/verify-release.yml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/verify-release.yml b/.github/workflows/verify-release.yml
index b6494c2..7550c8c 100644
--- a/.github/workflows/verify-release.yml
+++ b/.github/workflows/verify-release.yml
@@ -70,7 +70,11 @@ jobs:
             arch=$(dpkg-deb -f "$deb" Architecture)
             depends=$(dpkg-deb -f "$deb" Depends)
             echo "${arch}: ${depends}"
-            libc_ver=$(echo "$depends" | grep -oP 'libc6 \(>= \K[0-9.]+')
+            libc_ver=$(echo "$depends" | grep -oP 'libc6 \(>= \K[0-9.]+' || true)
+            if [ -z "$libc_ver" ]; then
+              echo "  (no libc6 dependency)"
+              continue
+            fi
             if [ "$(printf '%s\n%s' "$libc_ver" "$max_libc" | sort -V | tail -1)" != "$max_libc" ]; then
               echo "FAIL: ${arch} requires libc6 >= ${libc_ver}, but Debian 12 has ${max_libc}"
               exit 1

